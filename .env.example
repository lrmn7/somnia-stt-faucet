# Treasury wallet private key (64-character hex with or without 0x prefix)
FAUCET_PRIVATE_KEY=

# Cloudflare Turnstile Secret Key
TURNSTILE_SECRET_KEY=

# Random secret salt for privacy-preserving SHA-256 IP hashing (raw IPs are never stored)
IP_HASH_SECRET=

# Random secret salt for privacy-preserving SHA-256 wallet address hashing
WALLET_HASH_SECRET=

# Optional public Turnstile Site Key for frontend widget
VITE_TURNSTILE_SITE_KEY=

